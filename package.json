{
  "name": "purgeit",
  "version": "0.5.0",
  "description": "Find and safely delete regenerable dev build artifacts (node_modules, dist, target, Pods, ...) across your projects",
  "license": "MIT",
  "author": "Nandan Varma",
  "homepage": "https://purgeit.nandan.fyi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nandan-varma/purgeit.git"
  },
  "bugs": {
    "url": "https://github.com/nandan-varma/purgeit/issues"
  },
  "keywords": [
    "cli",
    "node_modules",
    "cleanup",
    "disk-space",
    "npkill",
    "dev-tools",
    "build-artifacts",
    "tui"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./schema.json": "./purgeit.schema.json"
  },
  "bin": {
    "purgeit": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "skills",
    "purgeit.schema.json"
  ],
  "scripts": {
    "schema": "tsx scripts/schema.ts",
    "build": "npm run schema && tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bytes": "^3.1.2",
    "c12": "^3.3.4",
    "commander": "^15.1.0",
    "env-paths": "^4.0.0",
    "ink": "^8.0.0",
    "ms": "^2.1.3",
    "p-limit": "^7.3.3",
    "picomatch": "^4.0.7",
    "react": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/bytes": "^3.1.6",
    "@types/ms": "^2.1.0",
    "@types/node": "^26.6.6",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "ink-testing-library": "^4.0.0",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
