{
  "name": "purgeit",
  "version": "0.5.1",
  "description": "Find and safely delete regenerable dev build artifacts (node_modules, dist, target, Pods, ...) across your projects",
  "keywords": [
    "build-artifacts",
    "cleanup",
    "cli",
    "dev-tools",
    "disk-space",
    "node_modules",
    "npkill",
    "tui"
  ],
  "homepage": "https://purgeit.nandan.fyi",
  "bugs": {
    "url": "https://github.com/nandan-varma/purgeit/issues"
  },
  "license": "MIT",
  "author": "Nandan Varma",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nandan-varma/purgeit.git"
  },
  "bin": {
    "purgeit": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "skills",
    "purgeit.schema.json"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./schema.json": "./purgeit.schema.json"
  },
  "scripts": {
    "build": "bun run generate && tsdown",
    "schema": "bun scripts/schema.ts",
    "fmt": "bun fmt",
    "fmt:check": "bun fmt --check",
    "lint": "oxlint src scripts test tsdown.config.ts vitest.config.ts",
    "lint:fix": "oxlint --fix src scripts test tsdown.config.ts vitest.config.ts",
    "typecheck": "tsgo --noEmit",
    "knip": "knip",
    "doctor": "react-doctor src/tui --no-supply-chain --yes --blocking warning",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check:package": "publint && attw --pack . --profile esm-only",
    "check": "bun run --parallel fmt:check lint typecheck knip doctor && bun run coverage && bun run build && bun run check:package && node scripts/smoke.mjs",
    "prepare": "lefthook install",
    "prepublishOnly": "bun run check",
    "generate": "bun scripts/schema.ts && bun scripts/docs-data.ts"
  },
  "dependencies": {
    "bytes": "^3.1.2",
    "c12": "^3.3.4",
    "commander": "^15.1.0",
    "env-paths": "^4.0.0",
    "ink": "^8.0.0",
    "p-limit": "^7.3.3",
    "picomatch": "^4.0.7",
    "react": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/bytes": "^3.1.6",
    "@types/node": "^26.6.6",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.3.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "^5.1.1",
    "ink-testing-library": "^4.0.0",
    "knip": "^6.46.1",
    "lefthook": "^2.2.2",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "publint": "^0.3.25",
    "react-doctor": "^0.9.23",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.4"
}
