    {
      "name": ".cxx",
      "kind": "gated",
      "categories": [
        "java-jvm"
      ],
      "description": "Android NDK/CMake native build cache (Android Studio)",
      "when": "build.gradle or build.gradle.kts or settings.gradle or settings.gradle.kts",
      "file": null
    },
    {
      "name": "build",
      "kind": "gated",
      "categories": [
        "javascript-typescript",
        "python",
        "apple",
        "cpp",
        "java-jvm",
        "dart-flutter",
        "rust"
      ],
      "description": "Generic build output directory name, reused by npm scripts, Python setuptools, CocoaPods/Xcode, CMake, Gradle, Flutter, and Cargo — gated on whichever manifest is actually present",
      "when": "Podfile or *.xcodeproj or *.xcworkspace or CMakeLists.txt or package.json or pyproject.toml or requirements.txt or build.gradle or build.gradle.kts or pubspec.yaml or Cargo.toml",
      "file": null
    },
    {
      "name": "vendor",
      "kind": "gated",
      "categories": [
        "php",
        "go",
        "rust",
        "ruby"
      ],
      "description": "Composer's PHP dependency directory, a Go module's vendored dependencies, Cargo's vendored crates, or Bundler's vendored gems — gated on whichever manifest is present",
      "when": "composer.json or go.mod or Cargo.toml or Gemfile",
      "file": null
    },
