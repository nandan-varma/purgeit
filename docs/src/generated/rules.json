      "name": "CACHEDIR.TAG",
      "kind": "marker",
      "categories": [
        "cache-marker"
      ],
      "description": "Any directory carrying a Cache Directory Tagging Specification tag (https://bford.info/cachedir/) — written by Cargo, Go, Zig, ccache, pytest and others to declare the directory a regenerable cache",
      "when": null,
      "file": "CACHEDIR.TAG"
    },
