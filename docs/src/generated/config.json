{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "defaults": {
      "default": true,
      "description": "Start from purgeit's built-in rules.",
      "type": "boolean"
    },
    "safe": {
      "default": [],
      "description": "Directory names that are safe to delete wherever they appear.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "gated": {
      "default": [],
      "description": "Directory names that are only deletable when `when` holds beside them.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "when": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "file": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "file"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "glob": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "glob"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "grep": {
                        "type": "object",
                        "properties": {
                          "file": {
                            "type": "string",
                            "minLength": 1
                          },
                          "pattern": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "file",
                          "pattern"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "grep"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "inside": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "inside"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              {
                "minItems": 1,
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "file": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "file"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "glob": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "glob"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "grep": {
                          "type": "object",
                          "properties": {
                            "file": {
                              "type": "string",
                              "minLength": 1
                            },
                            "pattern": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "file",
                            "pattern"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "grep"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "inside": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "inside"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              }
            ],
            "description": "Proof, in the directory beside it, that the directory is generated."
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "when"
        ],
        "additionalProperties": false
      }
    },
    "markers": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Identifies the rule in reports and `only` selections."
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "description": "A file inside the directory that tags it as a cache."
          },
          "signature": {
            "type": "string",
            "minLength": 1,
            "description": "Text the marker file must begin with."
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "file",
          "signature"
        ],
        "additionalProperties": false
      }
    },
    "disable": {
      "default": [],
      "description": "Built-in rule names to switch off.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ignore": {
      "default": [],
      "description": "Directory names that are never entered.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "exclude": {
      "default": [],
      "description": "Globs, relative to each scan root, that are skipped entirely.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "groups": {
      "default": {},
      "description": "Named sets of rules, selectable with `--only <group>`.",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "minAge": {
      "description": "Only offer artifacts untouched for at least this long.",
      "type": "string"
    },
    "minSize": {
      "description": "Only offer artifacts at least this large.",
      "type": "string"
    },
    "includeEmpty": {
      "description": "Offer artifacts that contain no files (normally dropped).",
      "type": "boolean"
    },
    "dormantAfter": {
      "description": "A project untouched for this long is dormant (default 30d). Drives sorting, the interactive R key and --stale.",
      "type": "string"
    },
    "depth": {
      "description": "Never descend deeper than this.",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "additionalProperties": false
}
